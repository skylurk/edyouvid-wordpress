7\u0635 \u0628\u0643 \u0641\u064a \u0627\u0644\u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0633\u0648\u062f\u0627\u0621"],"Message shown when a blacklisted IP tries to login":["\u0627\u0644\u0631\u0633\u0627\u0644\u0629 \u0627\u0644\u062a\u064a \u062a\u0638\u0647\u0631 \u0639\u0646\u062f \u0645\u062d\u0627\u0648\u0644\u0629 \u0639\u0646\u0648\u0627\u0646 IP \u0645\u062f\u0631\u062c \u0641\u064a \u0627\u0644\u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0633\u0648\u062f\u0627\u0621 \u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u062f\u062e\u0648\u0644"],"Attempts Left Message":["\u0645\u062d\u0627\u0648\u0644\u0627\u062a \u062a\u0631\u0643 \u0631\u0633\u0627\u0644\u0629 \u062a\u0631\u0643 \u0631\u0633\u0627\u0644\u0629"],"You have only %count% attempts":["\u0644\u062f\u064a\u0643 %count% \u0645\u062d\u0627\u0648\u0644\u0627\u062a \u0641\u0642\u0637"],"Message shown when login attempts remain. Use %count% for attempts count.":["\u062a\u0638\u0647\u0631 \u0627\u0644\u0631\u0633\u0627\u0644\u0629 \u0639\u0646\u062f \u0628\u0642\u0627\u0621 \u0645\u062d\u0627\u0648\u0644\u0627\u062a \u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u062f\u062e\u0648\u0644. \u0627\u0633\u062a\u062e\u062f\u0645 %count% \u0644\u062d\u0633\u0627\u0628 \u0639\u062f\u062f \u0627\u0644\u0645\u062d\u0627\u0648\u0644\u0627\u062a."],"Message for user(s) after reaching maximum login attempts. Use %TIME% for time remaining.":["\u0631\u0633\u0627\u0644\u0629 \u0644\u0644\u0645\u0633\u062a\u062e\u062f\u0645 (\u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646) \u0628\u0639\u062f \u0627\u0644\u0648\u0635\u0648\u0644 \u0625\u0644\u0649 \u0627\u0644\u062d\u062f \u0627\u0644\u0623\u0642\u0635\u0649 \u0644\u0645\u062d\u0627\u0648\u0644\u0627\u062a \u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u062f\u062e\u0648\u0644. \u0627\u0633\u062a\u062e\u062f\u0645 %TIME% \u0644\u0644\u0648\u0642\u062a \u0627\u0644\u0645\u062a\u0628\u0642\u064a."],"You are locked out for %TIME%":["\u0623\u0646\u062a \u0645\u063a\u0644\u0642 \u0628\u0633\u0628\u0628 %TIME%"],"Email Notifications":["\u0627\u0634\u0639\u0627\u0631\u0627\u062a \u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0627\u0644\u0643\u062a\u0631\u0648\u0646\u064a"],"Enable Lockout Notification":["\u062a\u0645\u0643\u064a\u0646 \u0625\u0639\u0644\u0627\u0645 \u0627\u0644\u0625\u063a\u0644\u0627\u0642"],"If enabled, a lockout notification will be sent to the specified email address.":["\u0641\u064a \u062d\u0627\u0644\u0629 \u0627\u0644\u062a\u0645\u0643\u064a\u0646\u060c \u0633\u064a\u062a\u0645 \u0625\u0631\u0633\u0627\u0644 \u0625\u0634\u0639\u0627\u0631 \u062a\u0623\u0645\u064a\u0646 \u0625\u0644\u0649 \u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a \u0627\u0644\u0645\u062d\u062f\u062f."],"Email Address(es)":["\u0639\u0646\u0648\u0627\u0646 (\u0639\u0646\u0627\u0648\u064a\u0646) \u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a"],"Comma separated list of email addresses to receive notifications":["\u0642\u0627\u0626\u0645\u0629 \u0639\u0646\u0627\u0648\u064a\u0646 \u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a \u0627\u0644\u0645\u0641\u0635\u0648\u0644\u0629 \u0628\u0641\u0648\u0627\u0635\u0644 \u0644\u062a\u0644\u0642\u064a \u0627\u0644\u0625\u0634\u0639\u0627\u0631\u0627\u062a"],"Email Subject":["\u0645\u0648\u0636\u0648\u0639 \u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a"],"Available variables:":["\u0627\u0644\u0645\u062a\u063a\u064a\u0631\u0627\u062a \u0627\u0644\u0645\u062a\u0627\u062d\u0629:"],"Site Name":["\u0627\u0633\u0645 \u0627\u0644\u0645\u0648\u0642\u0639"],"User Name":["\u0627\u0633\u0645 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645"],"Email Body":["\u0645\u062d\u062a\u0648\u0649 \u0627\u0644\u0628\u0631\u064a\u062f"],"Hello,\n\nAt your site %1$s, a user: %2$s was recently locked out from the IP: %3$s\non %4$s while trying to log in through %5$s.\n\nPlease visit your dashboard to unlock this user or add them to the blacklist.":["\u0645\u0631\u062d\u0628\u0627\u064b \u0628\u0643\u0645,\n\n\u0641\u064a \u0645\u0648\u0642\u0639\u0643 %1$s\u060c \u0623\u062d\u062f \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646: %2$s \u062a\u0645 \u062d\u0638\u0631\u0647 \u0645\u0624\u062e\u0631\u064b\u0627 \u0645\u0646 \u0639\u0646\u0648\u0627\u0646 IP: %3$s\n\u0639\u0644\u0649 %4$s \u0623\u062b\u0646\u0627\u0621 \u0645\u062d\u0627\u0648\u0644\u062a\u0647 \u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u062f\u062e\u0648\u0644 \u0645\u0646 \u062e\u0644\u0627\u0644 %5$s.\n\n\u064a\u0631\u062c\u0649 \u0632\u064a\u0627\u0631\u0629 \u0644\u0648\u062d\u0629 \u0627\u0644\u062a\u062d\u0643\u0645 \u0644\u0625\u0644\u063a\u0627\u0621 \u0642\u0641\u0644 \u0647\u0630\u0627 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0623\u0648 \u0625\u0636\u0627\u0641\u062a\u0647 \u0625\u0644\u0649 \u0627\u0644\u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0633\u0648\u062f\u0627\u0621."],"Lockout Time and Date":["\u0648\u0642\u062a \u0648\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0625\u063a\u0644\u0627\u0642"],"Device IP Address":["\u0639\u0646\u0648\u0627\u0646 IP \u0644\u0644\u062c\u0647\u0627\u0632"],"Login Gateway (wp-login, WooCommerce, etc.)":["\u0628\u0648\u0627\u0628\u0629 \u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u062f\u062e\u0648\u0644 (wp-login\u060c WooCommerce\u060c \u0625\u0644\u062e)"]}}}
#: build/index.js:1 src/LimitLoginSettings.js:931
msgid ""
"The Limit Login Attempts add-on helps you easily keep track of how many "
"times each user tries to log in and limits the number of attempts they can "
"make. This way, your website is protected from brute force attacks, when "
"hackers try lots of passwords to get in."
msgstr ""
"O complemento Limit Login Attempts ajuda a controlar facilmente quantas "
"vezes cada usuário tenta fazer login e limita o número de tentativas que ele "
"pode fazer. Dessa forma, seu site fica protegido contra ataques de força "
"bruta, quando os hackers tentam várias senhas para entrar."

#: build/index.js:1 src/LimitLoginSettings.js:950
msgid "Notifications"
msgstr "Notificações"

#: build/index.js:1 src/LimitLoginSettings.js:956
msgid "Attempt Details"
msgstr "Detalhes da tentativa"

#: build/index.js:1 src/LimitLoginSettings.js:612
msgid "Limit Concurrent Sessions"
msgstr "Limite de sessões simultâneas"

#: build/index.js:1 src/LimitLoginSettings.js:615
msgid "Restrict users to a maximum number of logins at the same time."
msgstr "Restrinja os usuários a um número máximo de logins ao mesmo tempo."

#: build/index.js:1 src/LimitLoginSettings.js:623
msgid "Max Session Count"
msgstr "Contagem máxima de sessões"

#: build/index.js:1 src/LimitLoginSettings.js:629
msgid "Specify the maximum number of allowed concurrent sessions per user."
msgstr ""
"Especifique o número máximo de sessões simultâneas permitidas por usuário."

#: build/index.js:1 src/LimitLoginSettings.js:636
msgid "Exclude Roles"
msgstr "Excluir funções"

#: build/index.js:1 src/LimitLoginSettings.js:650
msgid "Choose the roles for exclusion from limit concurrent sessions."
msgstr "Escolha as funções para exclusão do limite de sessões simultâneas."

#: build/index.js:1 src/LimitLoginSettings.js:658
msgid "Disable User Endpoints"
msgstr "Desativar pontos de extremidade do usuário"

#: build/index.js:1 src/LimitLoginSettings.js:662
msgid ""
"Blocks public access to WordPress REST API endpoints that expose user "
"information."
msgstr ""
"Bloqueia o acesso público aos pontos de extremidade da API REST do WordPress "
"que expõem informações do usuário."

#: build/index.js:1 src/LimitLoginSettings.js:666
msgid "Disable App Login Endpoints"
msgstr "Desativar os pontos de extremidade de login do aplicativo"

#: build/index.js:1 src/LimitLoginSettings.js:670
msgid "Blocks unauthorized logins through app login REST API endpoints."
msgstr ""
"Bloqueia logins não autorizados por meio de endpoints da API REST de login "
"de aplicativos."

#: build/index.js:1 src/LimitLoginSettings.js:674
msgid "Disable Application Password"
msgstr "Desativar a senha do aplicativo"

#: build/index.js:1 src/LimitLoginSettings.js:678
msgid ""
"Disable authentication using application passwords via XML-RPC or REST API."
msgstr ""
"Desative a autenticação usando senhas de aplicativos via XML-RPC ou API REST."

#: build/index.js:1 src/LimitLoginSettings.js:748
msgid "Blacklisted IP Message"
msgstr "Mensagem de IP na lista negra"

#: build/index.js:1 src/LimitLoginSettings.js:752
msgid "Your IP has been blacklisted"
msgstr "Seu IP foi colocado na lista negra"

#: build/index.js:1 src/LimitLoginSettings.js:753
msgid "Message shown when a blacklisted IP tries to login"
msgstr "Mensagem exibida quando um IP na lista negra tenta fazer login"

#: build/index.js:1 src/LimitLoginSettings.js:758
msgid "Attempts Left Message"
msgstr "Tentativas Mensagem deixada"

#: build/index.js:1 src/LimitLoginSettings.js:762
msgid "You have only %count% attempts"
msgstr "Você tem apenas %count% tentativas"

#: build/index.js:1 src/LimitLoginSettings.js:763
msgid ""
"Message shown when login attempts remain. Use %count% for attempts count."
msgstr ""
"Mensagem exibida quando ainda há tentativas de login. Use %count% para a "
"contagem de tentativas."

#: build/index.js:1 src/LimitLoginSettings.js:772
msgid ""
"Message for user(s) after reaching maximum login attempts. Use %TIME% for "
"time remaining."
msgstr ""
"Mensagem para o(s) usuário(s) após atingir o máximo de tentativas de login. "
"Use %TIME% para o tempo restante."

#: build/index.js:1 src/LimitLoginSettings.js:773
msgid "You are locked out for %TIME%"
msgstr "Você está bloqueado por %TIME%"


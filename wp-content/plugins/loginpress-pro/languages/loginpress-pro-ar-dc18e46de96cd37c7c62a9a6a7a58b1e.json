{"translation-revision-date":"2025-08-25 15:20+0500","generator":"WP-CLI\/2.12.0","source":"src\/HideLoginSettings.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"ar","plural-forms":"nplurals=6; plural=(n==0 ? 0 : n==1 ? 1 : n==2 ? 2 : n%100>=3 && n%100<=10 ? 3 : n%100>=11 && n%100<=99 ? 4 : 5);"},"Hide Login":["\u0625\u062e\u0641\u0627\u0621 \u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u062f\u062e\u0648\u0644"],"Rename Login Slug":["\u062a\u063a\u064a\u064a\u0631 \u0627\u0644\u0631\u0627\u0628\u0637 \u0627\u0644\u062b\u0627\u0628\u062a (slug) \u0644\u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u062f\u062e\u0648\u0644"],"Send Email":["\u0627\u0631\u0633\u0644 \u0628\u0631\u064a\u062f \u0627\u0644\u0643\u062a\u0631\u0648\u0646\u064a"],"Email Address":["\u0628\u0631\u064a\u062f \u0627\u0644\u0643\u062a\u0631\u0648\u0646\u064a"],"Generate Slug (Randomly)":["\u0625\u0646\u0634\u0627\u0621 \u0631\u0627\u0628\u0637 \u062b\u0627\u0628\u062a (slug) \u0628\u0634\u0643\u0644 (\u0639\u0634\u0648\u0627\u0626\u064a)"],"Reset Login Slug":["\u0625\u0639\u0627\u062f\u0629 \u062a\u0647\u064a\u0626\u0629 \u0627\u0644\u0631\u0627\u0628\u0637 \u0627\u0644\u062b\u0627\u0628\u062a (slug) \u0644\u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u062f\u062e\u0648\u0644"],"Email will be sent to the address defined below.":["\u0633\u064a\u062a\u0645 \u0627\u0631\u0633\u0627\u0644 \u0628\u0631\u064a\u062f \u0627\u0644\u0643\u062a\u0631\u0648\u0646\u064a \u0644\u0644\u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0645\u0639\u0631\u0651\u0641 \u0623\u062f\u0646\u0627\u0647."],"Send email after changing the wp-login.php slug?":["\u0625\u0631\u0633\u0627\u0644 \u0631\u0633\u0627\u0644\u0629 \u0628\u0631\u064a\u062f \u0627\u0644\u0643\u062a\u0631\u0648\u0646\u064a \u0628\u0639\u062f \u062a\u063a\u064a\u064a\u0631 \u0627\u0644\u0631\u0627\u0628\u0637 \u0627\u0644\u062f\u0627\u0626\u0645 (slug) \u0644\u0644 wp-login.php\u061f"],"Settings saved successfully.":["\u0644\u0648\u062